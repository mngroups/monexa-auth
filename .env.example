# Copy to .env for `pnpm dev`. Values below match docker-compose.yml.
NODE_ENV=development
PORT=9000
LOG_LEVEL=info

DATABASE_URL=postgres://monexa:monexa@localhost:5432/monexa
# Vercel: point at a pooler (PgBouncer transaction mode) and keep this at 1-3.
DB_POOL_MAX=10

# Public URL of this service; it is the `iss` of every token.
OIDC_ISSUER=http://localhost:9000
# THROWAWAY DEV KEY, committed on purpose. Never reuse it outside local development:
# generate your own with `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048`.
# Single line with literal \n escapes.
OIDC_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDMCVSRHCHpiq9m\nrGdFto1AHGEUO4fhfXlANFodkIEXNcBbEo83+1L+IpmSx7fh4gVCBfGERs00NBQD\nPRuHXSO089Oth4z1urpkFtGPUbjHu7rTflY3casW2SH3ijalR4yO90eJD3s05FaG\n6yuujvwWF/0inqwAydNjzL07JDOEMgchZv8shW+acntsadVlBXtl6vGo+OV3agrR\nanSneQWCcax1ncdsRRdojpiNL5leBIxlDeHQfxD7dpNbPHG0l+NQh9K2KWK4a2t2\nBfOiZEuuzna5bfP3sIEvmtSloUe1cOSSGwx7XIzR4Ak7Nw7MWLjIX5salBNtufam\nR61OtXJvAgMBAAECggEATT2zAAQwamMQJ8RYjDGho4Wa0rf+psSDZGTtQIf19r1o\nhpGuGjlQn9ilXsWwvRh9eRMa7UKIaJzWfqthgosl+1ja57SLDnOUIFPrHWCInURa\nY7pOFUs4w7uLelSef09ozK6cLCzqLYnLn+Pjc3+5uvt13udGoj3FguB9OqhnwEEr\nGYpPm2cRzWl/FMHFoF8nhKjnp5hV7hH/9N57fWv3jnXkZlWoRFfLGaAQ9yL33ttU\nCDrAmlYeZnqY40NR4CTVc8Rpbr+ZORl0BCQDdlSY2iNasFVy+b7u+7u0bzOJ68aw\nXvPfMgCRO3nN8ypoebzKmYV/MSNY03o5UVgrdODBAQKBgQDmic/UnfYY4UdRaqUH\nAfsmvY0IH8dEV7PL1SF8xuKfFj+fTNskXGZMGCisa6g6AzEvpqdx8+J9D6ERuWNk\nvQBNyerRdUwP2S7tM0dhn+vOniwtAsnMlvJl59+7o4oiI1dOjycgyihLLXlGPV+t\nlWN08bMnK4rg6zw/7poq40k6wQKBgQDikjXaCO3s9Fy/0+eoaeI8BOswVfPjjLdm\nw6x0a+7cMVMFK6DT3jzx+Q0N1tL5uFws5DgpG4FZqEI6UA/ZsK03NZLmrono75gm\niab8jdnsae1rC492UnZ9PISYFJoYuJTT4m049TR4fpWCkvBVWNSnwkiQLdQJhDa2\n/X9bckrpLwKBgCAv0YJ/42Ip4ckuOIg38JbCFDS0KyARlpq40QoYwn8vngZhtp7m\n/6lUHimkhkJDO9TJUcuJH3AShIxy87uW37n8nPpNhCcaTYD0jdzFdSjN0KEgKIiV\n8pXjv8r01E5b3M6tEet0Dhgg6zOxUfBsUQx8ymSHocYxUaIjcAbY4NqBAoGBAJy7\nuDUUaEK66E5rMJ34YWBTpr7RNt36wgR86BfBcoMwO9Yf0CnAWzioqLciHOBTALCt\nT4xgUqLLGsVsDQryhWDj1rNtmklhNUezgajEGDTLMkoSvTOE6CLKco8h8VeYmJva\nzuPP/HQ+XP7u1wKzaKiEZd4XVc8ffxonUqrX7apRAoGAOVERymz8Yd/JQObDp2i5\nT51RnECuEkIMHjYRNSUHsRCCBCwRLkNVwTJcIeTa+qzMCXIcHQQIfu2vVan2a4Ry\nOFj3qxPAaI0QxUrzJ8ZXSiMdFJJ4rEMXdwhOSxyNkpw+0WR9+HSHwqzHwNjIDLXU\nbB1XHKXEwaa+of5H0v7diPo=\n-----END PRIVATE KEY-----"
# Comma-separated cookie signing keys (first signs, all verify). Dev value only.
OIDC_COOKIE_KEYS=dev-cookie-key-change-me
# base64 of 32 random bytes (`openssl rand -base64 32`); encrypts client secrets. Dev value only.
CLIENT_SECRET_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvbmctISEhISE=

ADMIN_CLIENT_ID=monexa-admin
# Printed once by `pnpm auth:bootstrap`. Enables /v1/auth/* for the admin UI (this service is its backend).
ADMIN_CLIENT_SECRET=
# The admin UI's callback URL(s) and where central logout sends it back.
ADMIN_REDIRECT_URIS=http://localhost:3001/auth/callback
ADMIN_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/login
# Org (slug or id) whose logo the admin UI login shows; the admin lands in it.
ADMIN_ORG_HINT=monexa
# Read by `pnpm auth:bootstrap` only (not by the server). Remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Dev only, change it.
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# Comma-separated callback URLs of the admin UI.
BOOTSTRAP_ADMIN_REDIRECT_URIS=http://localhost:3001/auth/callback
# Comma-separated post-logout URLs registered on the admin app (added on a repeat run, never removed).
BOOTSTRAP_ADMIN_POST_LOGOUT_REDIRECT_URIS=http://localhost:3001/login
# Set to true once to issue a new admin app secret if it was lost.
# BOOTSTRAP_ROTATE_ADMIN_SECRET=true
LOCKOUT_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# Comma-separated; empty = no CORS.
CORS_ORIGINS=
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
# true behind a proxy that sets X-Forwarded-For (load balancer, Vercel).
TRUST_PROXY=false
